FIELDWARD_DB_URL=jdbc:postgresql://127.0.0.1:55432/fieldward
FIELDWARD_DB_USER=fieldward
FIELDWARD_DB_PASSWORD=

# Local HTTP only. Use true for HTTPS.
FIELDWARD_SECURE_COOKIE=false
# Optional initial admin. Provide both values to create the account.
FIELDWARD_ADMIN_EMAIL=
FIELDWARD_ADMIN_PASSWORD=

# Xiaomi MiMo pay-as-you-go API key (kept on the backend).
MIMO_API_KEY=
FIELDWARD_MENTOR_ENDPOINT=https://api.xiaomimimo.com/v1/chat/completions
FIELDWARD_MENTOR_MODEL=mimo-v2.6-pro
